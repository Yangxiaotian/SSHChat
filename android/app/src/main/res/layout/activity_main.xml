<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <!-- Sticky top banner (outside chat scroll). -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B5E20"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SSHChat"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFontMinus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="A-"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnFontPlus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="A+"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#C8E6C9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/loginPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvKeyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPubkey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#F0F0F0"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:typeface="monospace" />

            <Button
                android:id="@+id/btnCopyPubkey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="复制公钥" />

            <Button
                android:id="@+id/btnRestoreKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="从备份文件恢复密钥" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Linux 用户名"
                android:inputType="textNoSuggestions"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="连接" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="未连接"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="棋盘可左右滑；顶栏 A- / A+ 调字号"
            android:textSize="11sp"
            android:textColor="#888888" />

        <HorizontalScrollView
            android:id="@+id/hScrollChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="#FAFAFA"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <ScrollView
                android:id="@+id/scrollChat"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/chatLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="360dp"
                    android:orientation="vertical"
                    android:padding="8dp" />
            </ScrollView>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/suggestScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/suggestRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <EditText
            android:id="@+id/etDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:hint="消息或 /命令（点候选补全）"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="按住说话"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/btnPhoto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="拍照，长按录像"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_camera" />

            <ImageButton
                android:id="@+id/btnFile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="发送文件"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_folder" />

            <ImageButton
                android:id="@+id/btnCanvas"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="共享画板"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_canvas" />

            <Button
                android:id="@+id/btnSlash"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="/"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnTab"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Tab"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="发送"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="断开"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMediaHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="话筒按住发语音 · 相机点拍照/长按录像 · 文件夹发文件 · 画板"
            android:textSize="11sp"
            android:textColor="#888888" />
    </LinearLayout>
</LinearLayout>
